{
  "name": "telegram-gpt-bot",
  "version": "2.0.0",
  "description": "Telegram bot powered by various large language models.",
  "main": "src/hennos.js",
  "scripts": {
    "clean": "rimraf ./build",
    "build": "npm-run-all clean prisma:generate lint tsc:emit",
    "validate": "npm-run-all lint tsc:noemit",
    "tsc:emit": "tsc",
    "tsc:noemit": "tsc --noEmit",
    "tsc:test": "tsc -p tsconfig.test.json",
    "tsc:noemit:watch": "tsc --noEmit --watch",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "start": "npm run migrate:deploy && node build/hennos.js",
    "start:cli": "node build/client/cli.js",
    "script:email": "npm run build && node build/scripts/email.js",
    "script:bsky": "npm run build && node build/scripts/bsky.js",
    "script:token": "npm run build && node build/scripts/token.js",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset",
    "migrate:new": "prisma migrate dev --create-only",
    "prisma:generate": "prisma generate",
    "dev": "npm-run-all build start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "author": "Mark Repka",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.17.0"
  },
  "dependencies": {
    "@llamaindex/ollama": "^0.1.24",
    "@llamaindex/readers": "^3.1.22",
    "@mozilla/readability": "^0.6.0",
    "@prisma/client": "^6",
    "@supabase/supabase-js": "^2.108.2",
    "@temporalio/client": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.0",
    "googleapis": "^173.0.0",
    "jsdom": "^29.1.1",
    "llamaindex": "^0.12.1",
    "mime-types": "^3.0.2",
    "node-telegram-bot-api": "^1.1.2",
    "ollama": "^0.6.3",
    "openai": "^6.45.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^25.2.1",
    "tiktoken": "^1.0.22",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@temporalio/nyc-test-coverage": "1.25",
    "@temporalio/testing": "^1.25.0",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitest/coverage-istanbul": "^4.1.12",
    "eslint": "^8",
    "npm-run-all": "^4.1.5",
    "prisma": "^6",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
