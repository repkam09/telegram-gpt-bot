{
  "name": "telegram-gpt-bot",
  "version": "2.0.0",
  "description": "Telegram bot powered by various large language models.",
  "main": "src/hennos.js",
  "scripts": {
    "clean": "rimraf ./build",
    "build": "npm-run-all clean prisma:generate lint tsc:emit",
    "validate": "npm-run-all lint tsc:noemit tsc:test:noemit",
    "tsc:emit": "tsc",
    "tsc:noemit": "tsc --noEmit",
    "tsc:test": "tsc -p tsconfig.test.json",
    "tsc:test:noemit": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "start": "npm run migrate:deploy && node build/hennos.js",
    "start:cli": "node build/client/cli.js",
    "script:email": "npm run build && node build/scripts/email.js",
    "script:bsky": "npm run build && node build/scripts/bsky.js",
    "script:token": "npm run build && node build/scripts/token.js",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset",
    "migrate:new": "prisma migrate dev --create-only",
    "prisma:generate": "prisma generate",
    "dev": "npm-run-all build start",
    "test": "npm-run-all tsc:test test:coverage",
    "test:coverage": "vitest run --coverage"
  },
  "author": "Mark Repka",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.17.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@prisma/client": "^6",
    "@supabase/supabase-js": "^2.108.2",
    "@temporalio/client": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "dotenv": "^18.0.10",
    "express": "^5.2.1",
    "google-auth-library": "^11.3.4",
    "googleapis": "^189.0.0",
    "jsdom": "^31.0.0",
    "mime-types": "^3.0.2",
    "node-telegram-bot-api": "^1.1.2",
    "openai": "^7.56.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^25.2.1",
    "tiktoken": "^1.0.22",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@temporalio/nyc-test-coverage": "1.25",
    "@temporalio/testing": "^1.25.0",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitest/coverage-istanbul": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "npm-run-all": "^4.1.5",
    "prisma": "^6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "puppeteer@25.17.0": true,
    "prisma": false,
    "@prisma/client": false,
    "@prisma/engines": false,
    "@swc/core": false,
    "protobufjs": false
  }
}
