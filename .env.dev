# Hennos Feature Flags
HENNOS_TELEGRAM_ENABLED="false"
HENNOS_API_ENABLED="false"
HENNOS_GMAIL_ENABLED="false"
HENNOS_BLUESKY_ENABLED="false"
HENNOS_SUPABASE_ENABLED="false"
HENNOS_MEMORY_ENABLED="false"

# LLM Provider Settings
HENNOS_LLM_PROVIDER="ollama"
HENNOS_LEGACY_LLM_PROVIDER="ollama"

# LiteLLM Options
LITELLM_LLM="hennos_dynamic,32000"
LITELLM_BASE_URL="https://api.example.com"
LITELLM_API_KEY="sk-EXAMPLE"
LITELLM_TRANSCRIPTION_MODEL="whisper-1"
LITELLM_IMAGE_MODEL="gemini-image"

# OpenAI Realtime SIP (the only direct OpenAI usage left)
OPENAI_API_KEY="openai-api-key"

# Ollama LLM Options
OLLAMA_LLM="repkam09/hennos-qwen3.5:latest,102400"
OLLAMA_LLM_EMBED="nomic-embed-text:latest,8192"
OLLAMA_HOST="localhost"
OLLAMA_PORT="11434"

# Telegram configuration
TELEGRAM_BOT_KEY="telegram-bot-key"
TELEGRAM_BOT_ADMIN="23456789"
TELEGRAM_BOT_WEBHOOK_EXTERNAL="https://dev.hennos.app"

# Hennos API Configuration
HENNOS_API_PORT="16006"

# Storage Database
DATABASE_URL="file:./data/hennos.sqlite"

# File Storage
LOCAL_STORAGE="./data/"

# Hennos Configuration
HENNOS_VERBOSE_LOGGING="true"
HENNOS_DEVELOPMENT_MODE="true"

# Services
OPEN_WEATHER_API="open-weather-api-key"
WOLFRAM_ALPHA_APP_ID="wolfram-alpha-app-id"
GITHUB_API_KEY="github-api-key"
BRAVE_SEARCH_API_KEY="brave-search-api-key"

# Jellyseer
JELLYSEER_API_KEY="jellyseer-api-key"
JELLYSEER_BASE_URL="localhost:5055"
JELLYFIN_BASE_URL="http://localhost:8096"

# Terrarium
TERRARIUM_ENABLED="false"
TERRARIUM_HOST="localhost"
TERRARIUM_PORT="8080"

# Temporal Configuration
TEMPORAL_HOST="localhost"
TEMPORAL_PORT="7233"
TEMPORAL_NAMESPACE="default"
TEMPORAL_TASK_QUEUE="development"

# Gmail Configuration
GMAIL_CLIENT_ID="gmail-client-id"
GMAIL_CLIENT_SECRET="gmail-client-secret"
GMAIL_REFRESH_TOKEN="gmail-refresh-token"

# Google Image Generation Configuration

# AT Proto / Bluesky Configuration
AT_PROTO_SERVICE="https://bsky.social"
AT_PROTO_USERNAME="bluesky-username"
AT_PROTO_PASSWORD="bluesky-password"

# S3 Storage
S3_ACCESS_KEY="s3-access-key"
S3_SECRET_KEY="s3-secret-key"
S3_BUCKET_NAME="hennos-dev"
S3_ENDPOINT="http://localhost:16009"

# Supabase Configuration
SUPABASE_URL="supabase-url"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_example"
SUPABASE_KEEPALIVE_EMAIL="supabase-keepalive@example.com"
SUPABASE_KEEPALIVE_PASSWORD="supabase-keepalive-password"